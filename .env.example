# Copy this file to .env.local and fill in your real values.
# .env.local is already git-ignored and is what the app actually reads.

# Public site URL (used for SEO metadata + sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Shown in the header CTA, footer, and WhatsApp button.
# Phone number shown to humans, any readable format.
NEXT_PUBLIC_PHONE_DISPLAY=+91 98765 43210

# WhatsApp number the floating button messages.
# Country code + number, digits only, no +, no spaces, no leading zero.
# Example: India number 98765 43210 -> 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Inbox that should receive contact-page / product enquiries (display only;
# the actual delivery inbox is whatever email you used to create the
# Web3Forms access key below).
NEXT_PUBLIC_CONTACT_EMAIL=sales@yourdomain.com

# Get a free key at https://web3forms.com (sign up with the inbox above).
# Without this key, enquiries are accepted and logged to the server console
# instead of being emailed — useful for local testing, not for production.
WEB3FORMS_ACCESS_KEY=
